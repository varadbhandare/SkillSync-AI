# SkillSync AI Environment Configuration Example
PORT=5000
NODE_ENV=development

# Reverse Proxy Trust (Required for Render, Railway, Fly.io, Heroku, Nginx to properly handle client IPs & rate limiting)
TRUST_PROXY=false

# MongoDB Connection (Local or Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/skillsync_ai

# JWT Authentication (Required: server will fail fast at startup if missing; min 32 chars)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRE=30d

# CORS Allowlist (Comma-separated URLs, null for local file:// access, or * for open development)
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,null

# Google Gemini API Configuration
# Optional: If omitted or unset, the proctoring engine seamlessly uses the deterministic rules evaluator,
# and the career mentor uses the verified multi-category knowledgebase & intent matcher.
GEMINI_API_KEY=

# LLM Model Selection for Mock Interview Evaluation & Mentor Chat
# Recommended: gemini-2.5-flash (Fast, accurate, cost-effective)
# Fallback options: gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MENTOR_MODEL=gemini-2.5-flash

# Execution timeouts (in milliseconds)
INTERVIEW_LLM_TIMEOUT_MS=8000
