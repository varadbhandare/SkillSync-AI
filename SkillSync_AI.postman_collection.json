    {
      "name": "8. AI Mock Interview & AI Mentor Chat (Proctored Session Engine)",
      "item": [
        {
          "name": "1. Create & Start Proctored Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    if (res.session && res.session.id) {",
                  "        pm.environment.set(\"sessionId\", res.session.id);",
                  "        console.log(\"Saved sessionId:\", res.session.id);",
                  "    }",
                  "    if (res.currentQuestion && res.currentQuestion.id) {",
                  "        pm.environment.set(\"currentQuestionId\", res.currentQuestion.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetRole\": \"ai_ml\",\n  \"consentGiven\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/modules/interviews/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "modules",
                "interviews",
                "sessions"
              ]
            },
            "description": "Creates and initializes an authenticated, proctored mock interview session linked to the logged-in candidate."
